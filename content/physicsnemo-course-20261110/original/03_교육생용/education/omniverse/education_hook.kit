[package]
title = "Educational Hook - FEA and AI"
version = "1.0.0"

[dependencies]
"omni.kit.uiapp" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.renderer.core" = {}
"omni.kit.renderer.capture" = {}
"omni.hydra.rtx" = {}

[settings]
app.window.title = "Educational Hook - FEA and AI"
app.window.width = 1500
app.window.height = 950
app.content.emptyStageOnStart = false
app.extensions.registryEnabled = false
app.settings.persistent = false
app.viewport.defaults.guide.grid.visible = false
renderer.enabled = "rtx"
renderer.active = "rtx"
rtx.rendermode = "RaytracedLighting"
# Linear applies camera exposure; raw/clamp overexposes unitless USD emissive colors.
rtx.post.tonemap.op = 1
rtx.post.tonemap.filmIso = 100
rtx.post.tonemap.cameraShutter = 50
rtx.post.tonemap.exposureTime = 0.02
rtx.post.tonemap.fNumber = 5
app.docks.disabled = false
app.settings.loadUserConfig = false
